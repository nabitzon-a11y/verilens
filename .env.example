# =====================================================================
# VeriLens 환경변수 예시
# 이 파일을 복사해 `.env.local` 로 저장한 뒤 값을 채우세요.
#   PowerShell:  Copy-Item .env.example .env.local
# `.env.local` 은 .gitignore 에 포함되어 있으므로 절대 커밋되지 않습니다.
# =====================================================================

# ---------------------------------------------------------------------
# [서버 전용] Pi Platform API Key
#  - Pi Developer Portal(Pi Browser > develop.pi) 에서 앱 등록 후 발급
#  - 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요 (클라이언트 번들에 노출됨)
#  - 비워두면 결제 승인/완료가 Mock Approval 모드로 자동 폴백됩니다
# ---------------------------------------------------------------------
PI_API_KEY=
PI_API_BASE_URL=https://api.minepi.com

# ---------------------------------------------------------------------
# [서버 전용] Pi Developer Portal 도메인 소유 확인 키
#  - Portal 에서 앱 URL 등록 시 발급되는 validation key 를 붙여넣으면
#    https://<도메인>/validation-key.txt 로 자동 제공됩니다
# ---------------------------------------------------------------------
PI_VALIDATION_KEY=

# ---------------------------------------------------------------------
# [서버 전용, 선택] A2U(App-to-User) 실제 출금용 앱 지갑 시드
#  - 비워두면 '보상 청구(Claim)'는 Mock 정산으로 처리됩니다
#  - 실제 A2U 연동은 해커톤 MVP 이후 단계에서 활성화하세요
# ---------------------------------------------------------------------
PI_WALLET_PRIVATE_SEED=

# ---------------------------------------------------------------------
# [서버 전용] 로그인 세션 쿠키 / PiVerify 세션 토큰 서명용 비밀키
#  - 32자 이상 무작위 문자열로 교체하세요
#  - PowerShell 생성 예: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
# ---------------------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---------------------------------------------------------------------
# [서버 전용] 데이터 저장소 (Repository 패턴)
#  - json     : 로컬 JSON 파일에 저장 (로컬 개발/시연 권장)
#  - memory   : 서버 메모리에만 저장 (재시작 시 초기화)
#  - supabase : Supabase(Postgres) 영구 저장 (Vercel 등 서버리스 배포 권장)
#               supabase/schema.sql 을 먼저 실행하세요
# ---------------------------------------------------------------------
DATA_STORE=json
DATA_FILE_PATH=.data/verilens.json

# DATA_STORE=supabase 일 때만 필요 (Supabase > Project Settings > API)
# service_role 키는 절대 NEXT_PUBLIC_ 을 붙이거나 클라이언트에 노출하지 마세요
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# [클라이언트 공개 가능] 앱 설정
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=VeriLens
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pi SDK 샌드박스(Testnet) 모드. 개발/해커톤 시연 중에는 true
NEXT_PUBLIC_PI_SANDBOX=true

# PiNet 공유 링크 기본 주소 (Developer Portal 에서 확인한 앱 PiNet 주소)
# 비워두면 NEXT_PUBLIC_APP_URL 기반 웹 링크로 공유됩니다
NEXT_PUBLIC_PINET_URL=

# Pi Browser 밖(일반 Chrome/Safari)에서 접속 시 Demo Sandbox Mode 허용 여부
# 심사위원 시연을 위해 기본 true. 실제 운영 배포 시 false 권장
NEXT_PUBLIC_ALLOW_DEMO_MODE=true
